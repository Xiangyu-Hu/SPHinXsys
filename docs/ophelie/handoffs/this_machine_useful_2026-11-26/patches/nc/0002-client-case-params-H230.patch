+inline void applyClientStirringDevelopmentToLiterature(FrenchLiteratureParameters &lit,
+                                                       const OphelieClientCaseParams &p)
+{
+    lit.regime = FrenchLiteratureRegime::MechanicallyStirred;
+    lit.frequency_hz = p.frequency_hz;
